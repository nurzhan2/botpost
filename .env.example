# Токен телеграм-бота от @BotFather
BOT_TOKEN=
# Кому доступны /status и /testpost (id через запятую, узнать у @userinfobot)
ADMIN_IDS=
# Путь к базе. Локально можно не задавать. На Railway: /data/bot.db (+ volume в /data)
DB_PATH=

# --- источник и получатель (необязательно, есть дефолты в config.py) ---
# Числовой id канала-источника — надёжнее username. Узнать: переслать пост из
# канала боту @userinfobot, либо взять из лога строки not_source.
SOURCE_TG_CHAT_ID=
SOURCE_TG_USERNAME=
TARGET_TG_CHANNEL=

# --- VK (необязательно) ---
# Токен VK-сообщества (Управление -> Работа с API -> Ключ доступа).
VK_GROUP_TOKEN=
# id беседы: открыть беседу в vk.com/im -> в адресе sel=cN, N это chat_id.
# Пусто или <=1 -> VK-поток не стартует вообще.
VK_CHAT_ID=
